{
  "name": "flagforge-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:netlify": "netlify dev",
    "build": "node scripts/check-release.mjs && tsc --noEmit && tsc -p netlify/tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsc -p netlify/tsconfig.json && node --test tests/domain.test.mjs tests/release.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-flagforge 'node --test tests/rules.emulator.mjs'",
    "test:backend": "firebase emulators:exec --only auth,firestore --project demo-flagforge 'tsc -p netlify/tsconfig.json && node --test tests/backend.emulator.mjs'",
    "test:budget": "node scripts/check-budget.mjs"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "animejs": "^4.0.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^14.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.10.0",
    "firebase-tools": "^14.0.0",
    "netlify-cli": "^27.8.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
