# Copy this to .env for local Netlify Functions testing (`netlify dev`).
# NEVER commit the real .env — it's already in .gitignore.
#
# Set the real value in the Netlify dashboard:
#   Site settings → Environment variables → FIREBASE_SERVICE_ACCOUNT_JSON
# Value = the full JSON contents of a Firebase service account key
# (Firebase console → Project settings → Service accounts → Generate new
# private key), pasted as a single-line JSON string.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
