# Set exactly one mode. Demo is only for an explicitly requested local fixture/test run.
# Production and Netlify branch deploys must use firebase. Empty values intentionally fail release checks.
VITE_DATA_MODE=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=false
VITE_SUPPORT_EMAIL=

# Server-only Netlify Function secrets. Never prefix these with VITE_ or commit real values.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
