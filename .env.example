# With no configuration the app runs a clearly labeled, local fixture preview.
# Production builds must use VITE_DATA_MODE=firebase and a STAGING project first.
VITE_DATA_MODE=demo
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_REGION=us-central1
VITE_USE_EMULATORS=false
VITE_SUPPORT_EMAIL=
