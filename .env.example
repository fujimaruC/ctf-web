# With no configuration the app runs a clearly labeled, local fixture preview.
# Production builds must use VITE_DATA_MODE=firebase and a STAGING project first.
VITE_DATA_MODE=demo
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=false
VITE_SUPPORT_EMAIL=

# Server-only Netlify Function variables. Leave these empty in source control.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
